# File Keeper environment configuration
# Copy this file to .env and fill in your values

# Application
VITE_APP_NAME=File Keeper
VITE_APP_VERSION=0.1.0

# Storage
VITE_STORAGE_TYPE=indexeddb

# OCR (Phase 5)
VITE_OCR_PROVIDER=tesseract
VITE_OCR_LANG=eng

# ML / Classification (Phase 6)
VITE_ML_PROVIDER=mlkit
VITE_ML_CONFIDENCE_THRESHOLD=0.7

# Optional cloud services
VITE_API_BASE_URL=
VITE_API_KEY=
